# AURA AI OS runtime configuration template.
# Copy values into your process/service environment. Never commit real secrets.

# -------------------- Local AI / Ollama --------------------
AURA_OLLAMA_URL=http://127.0.0.1:11434
AURA_OLLAMA_MODELS=qwen3,deepseek-r1
AURA_OLLAMA_THINK=false
AURA_OLLAMA_TIMEOUT_SECONDS=120
AURA_OLLAMA_MAX_CONCURRENCY=1
AURA_AI_OPINIONS_PER_ROLE=1
AURA_AI_AGENT_TIMEOUT_SECONDS=240

# -------------------- Exness / MT5 DEMO --------------------
AURA_MT5_DEMO_LOGIN=
AURA_MT5_DEMO_PASSWORD=
AURA_MT5_DEMO_SERVER=
AURA_MT5_TERMINAL_PATH=

# -------------------- Dhan market data --------------------
AURA_DHAN_CLIENT_ID=
AURA_DHAN_ACCESS_TOKEN=

# -------------------- Shoonya read-only data --------------------
AURA_SHOONYA_USER_ID=
AURA_SHOONYA_ACCOUNT_ID=
AURA_SHOONYA_SESSION_TOKEN=

# -------------------- Flattrade read-only data --------------------
AURA_FLATTRADE_USER_ID=
AURA_FLATTRADE_ACCOUNT_ID=
AURA_FLATTRADE_ACCESS_TOKEN=

# -------------------- OANDA read-only/practice data --------------------
AURA_OANDA_ACCOUNT_ID=
AURA_OANDA_ACCESS_TOKEN=
AURA_OANDA_ENVIRONMENT=practice

# -------------------- Optional free intelligence --------------------
AURA_FRED_API_KEY=
AURA_ALPHA_VANTAGE_API_KEY=

# -------------------- LIVE MONEY: intentionally blank --------------------
# Do not set these during research, public-data testing, paper, or broker demo.
AURA_HUMAN_LIVE_APPROVAL_ID=
AURA_LIVE_TRADING_ENABLED=
